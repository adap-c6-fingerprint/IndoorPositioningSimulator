{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imdf-positioning-simulator:scenario:1.0",
  "title": "IMDF indoor positioning simulation scenario",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "map",
    "coordinateReference",
    "localBounds",
    "initialPosition",
    "anchors",
    "movementStep",
    "fingerprintGridSpacing",
    "minimumVisibleRSSI"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "map": {
      "type": "object",
      "required": ["venueName", "levelID", "levelOrdinal"],
      "properties": {
        "venueID": { "type": ["string", "null"] },
        "venueName": { "type": "string" },
        "manifestVersion": { "type": ["string", "null"] },
        "levelID": { "type": "string" },
        "levelOrdinal": { "type": "integer" }
      }
    },
    "coordinateReference": {
      "type": "object",
      "required": ["origin"],
      "properties": { "origin": { "$ref": "#/$defs/geographicCoordinate" } }
    },
    "localBounds": {
      "type": "object",
      "required": ["minimumEast", "maximumEast", "minimumNorth", "maximumNorth"],
      "properties": {
        "minimumEast": { "type": "number" },
        "maximumEast": { "type": "number" },
        "minimumNorth": { "type": "number" },
        "maximumNorth": { "type": "number" }
      }
    },
    "initialPosition": { "$ref": "#/$defs/indoorCoordinate" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "position", "referenceRSSI", "pathLossExponent"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["wifi", "beacon"] },
          "position": { "$ref": "#/$defs/indoorCoordinate" },
          "referenceRSSI": { "type": "number" },
          "pathLossExponent": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "movementStep": { "type": "number", "exclusiveMinimum": 0 },
    "fingerprintGridSpacing": { "type": "number", "exclusiveMinimum": 0 },
    "minimumVisibleRSSI": { "type": "number" }
  },
  "$defs": {
    "geographicCoordinate": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "indoorCoordinate": {
      "type": "object",
      "required": ["coordinate", "levelOrdinal"],
      "properties": {
        "coordinate": { "$ref": "#/$defs/geographicCoordinate" },
        "levelOrdinal": { "type": "integer" }
      }
    }
  }
}
